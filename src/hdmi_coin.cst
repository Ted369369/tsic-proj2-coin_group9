IO_LOC "tmds_d_p[0]" 30,29;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 32,31;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 35,34;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_p" 28,27;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;

IO_LOC "resetn" 14;
IO_PORT "resetn" PULL_MODE=UP;
IO_LOC "clk" 45;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "btn_start" 15;
IO_PORT "btn_start" PULL_MODE=UP BANK_VCCIO=1.8;

IO_LOC "btn_left" 13;
IO_PORT "btn_left" PULL_MODE=UP BANK_VCCIO=1.8;

IO_LOC "btn_right" 17;
IO_PORT "btn_right" PULL_MODE=UP BANK_VCCIO=1.8;

IO_LOC "btn_skill" 18;
IO_PORT "btn_skill" PULL_MODE=UP BANK_VCCIO=1.8;

// Square-wave sound out. Bank 3 is 1.8V, so drive a passive buzzer through a
// transistor/amp rather than straight off the pin if you want real volume.
IO_LOC "snd" 16;
IO_PORT "snd" PULL_MODE=NONE BANK_VCCIO=1.8;
